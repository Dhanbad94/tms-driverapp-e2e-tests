# Copy to `.env` (git-ignored) and `source .env` before running. No real values belong in this file.
TMS_ENV=staging
TMS_APPIUM_URL=http://127.0.0.1:4723
# Path to the staging-flavor APK (omit if the app is already installed on the device)
TMS_APK_PATH=
# Optional device selection
TMS_UDID=
TMS_DEVICE_NAME=
TMS_PLATFORM_VERSION=
# Later phases (not used by the Phase A launch smoke test): provide through a secret store, never commit
# TMS_DRIVER_PHONE=
# TMS_DRIVER_PASSCODE=
# Country picker selection before typing the number (defaults: +91 / India)
# TMS_DRIVER_ISD=+91
# TMS_DRIVER_COUNTRY=India

# Driver API used to assign a ride to the QA driver (non-production host only; preprod and prod are refused).
# The contract comes from the Playwright rider-app suite; it is unverified against the staging build.
# TMS_TRIP_API_URL=https://<staging-driver-api-host>/driver/api/v3
# TMS_TRIP_AUTH_VALUE=            # gateway header value, "Basic <base64>"; secret store only
# TMS_DISPATCHER_PHONE=           # a driver account used only for API calls (NOT the driver on the device)
# TMS_DISPATCHER_ISD=91
# TMS_DISPATCHER_PASSCODE=
# TMS_TRIP_DRIVER_ID=             # numeric id of the QA driver that rides are assigned to
# TMS_TRIP_RIDER_NAME=            # rider name of a ride already waiting in the queue
