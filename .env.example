# Copy to `.env` (git-ignored) and `source .env` before running. No real values belong in this file.
TMS_ENV=staging
TMS_APPIUM_URL=http://127.0.0.1:4723
# Path to the staging-flavor APK (omit if the app is already installed on the device)
TMS_APK_PATH=
# Optional device selection
TMS_UDID=
TMS_DEVICE_NAME=
TMS_PLATFORM_VERSION=
# Later phases (not used by the Phase A launch smoke test): provide through a secret store, never commit
# TMS_DRIVER_PHONE=
# TMS_DRIVER_PASSCODE=
# Country picker selection before typing the number (defaults: +91 / India)
# TMS_DRIVER_ISD=+91
# TMS_DRIVER_COUNTRY=India

# --- Rider API: creates the ride (POST .../rider/api/v1/request, header token-id = org code) ---
# Non-production hosts only. Provide EITHER a ready Bearer token OR the guest-user gateway credential.
# TMS_RIDER_API_URL=https://riderapi-staging.trackmyshuttle.com/rider/api/v1
# TMS_RIDER_BEARER=               # secret store only
# TMS_RIDER_GATEWAY_AUTH=         # full "Basic <base64>" value for /guest-user; secret store only
# TMS_RIDER_ORG=ODASAP            # value of the token-id header
# TMS_RIDER_PHONE=                # optional: overrides the rider phone in the request template (the rider may get SMS)

# --- Driver API: finds the ride in the queue and assigns it to the QA driver (non-production hosts only) ---
# The contract comes from the Playwright rider-app suite; it is unverified against the staging build.
# TMS_TRIP_API_URL=https://<staging-driver-api-host>/driver/api/v3
# TMS_TRIP_AUTH_VALUE=            # gateway header value, "Basic <base64>"; secret store only
# TMS_DISPATCHER_PHONE=           # a driver account used only for API calls (NOT the driver on the device)
# TMS_DISPATCHER_ISD=91
# TMS_DISPATCHER_PASSCODE=
# TMS_DISPATCHER_USE_QA_DRIVER=true  # use the QA driver itself as the API account (an API login signs the app out; do API calls before the app login)
# TMS_TRIP_DRIVER_ID=             # optional: numeric id of the QA driver (otherwise read from the login token)


# --- Second staging driver ("Automation Driver 2"): target of the (currently skipped) "assign to another driver" test; API only ---
# TMS_DRIVER2_ISD=91
# TMS_DRIVER2_PHONE=
# TMS_DRIVER2_PASSCODE=
